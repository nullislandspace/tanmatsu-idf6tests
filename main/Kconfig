menu "IDF6 SD card test"

    config IDF6TEST_VARIANT_NAME
        string "Variant name, shown in reports"
        default "base"

    config IDF6TEST_WITH_HOSTED
        bool "Build with ESP-Hosted and WiFi"
        default y
        help
            With ESP-Hosted, the SDIO transport to the radio claims the SDMMC
            controller before app_main, and the SD card is mounted with no-op
            host init/deinit (as tanmatsu-graceloader does). Without it, the
            SD card owns the controller alone.

    config IDF6TEST_PATTERN_SIZE_MB
        int "Size of the pattern file on the SD card, in MB"
        default 8

endmenu
